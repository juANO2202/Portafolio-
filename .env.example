# Copia este archivo a .env.local y ajusta el valor.
# URL pública del sitio (para Open Graph). Ejemplo en producción: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formulario de contacto (https://resend.com). Sin RESEND_API_KEY el formulario responde "no configurado".
RESEND_API_KEY=
# Opcional. Por defecto se usa el correo de data/profile.ts.
CONTACT_TO_EMAIL=
# Opcional. Con dominio verificado en Resend, ej: Portafolio <hola@tu-dominio.com>
CONTACT_FROM_EMAIL=
